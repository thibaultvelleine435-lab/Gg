local reportCount = 0

local function addReport(text, color, level)
    reportCount += 1
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 20)
    lbl.BackgroundColor3 = (level == "header")
        and Color3.fromRGB(40, 32, 60)
        or Color3.fromRGB(20, 20, 28)
    lbl.BorderSizePixel = 0
    lbl.Text = "  " .. text
    lbl.TextColor3 = color or Color3.fromRGB(200, 200, 220)
    lbl.Font = (level == "header") and Enum.Font.GothamBold or Enum.Font.Code
    lbl.TextSize = (level == "header") and 13 or 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.LayoutOrder = reportCount
    lbl.Parent = reportScroll
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 3)
    task.defer(function()
        reportScroll.CanvasPosition = Vector2.new(0, reportScroll.AbsoluteCanvasSize.Y)
    end)
    return lbl
end

local function clearReport()
    reportCount = 0
    for _, c in ipairs(reportScroll:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
end

local CATEGORIES = {
