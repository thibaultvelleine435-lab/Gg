      keys = {"reward","prize","loot","drop","gift","bonus","chest","crate"} },
}

local function matchesCategory(name, category)
    local lower = name:lower()
    for _, kw in ipairs(category.keys) do
        if lower:find(kw, 1, true) then return true end
    end
    return false
end

local function runAnalysis()
    clearReport()
    addReport("🤖 Analyse en cours...", Color3.fromRGB(180, 160, 255), "header")
    task.wait(0.1)

    local t0 = os.clock()
    local total = 0
    local stats = {}
    local found = {}

    for _, cat in ipairs(CATEGORIES) do
        found[cat.nom] = {}
    end

    for _, d in ipairs(game:GetDescendants()) do
        total += 1
        stats[d.ClassName] = (stats[d.ClassName] or 0) + 1
        for _, cat in ipairs(CATEGORIES) do
            if matchesCategory(d.Name, cat) then
                if #found[cat.nom] < 30 then
                    table.insert(found[cat.nom], {
                        path = d:GetFullName(),
                        class = d.ClassName,
                    })
                end
                break
            end
        end
    end

    local dt = os.clock() - t0
    addReport(string.format("✅ Scan : %d instances en %.2fs", total, dt),
        Color3.fromRGB(150, 255, 150), "header")
    addReport("")

    for _, cat in ipairs(CATEGORIES) do
        local list = found[cat.nom]
        if #list > 0 then
            addReport(string.format("%s — %d trouvés", cat.nom, #list), cat.color, "header")
            for i = 1, math.min(#list, 10) do
                addReport(string.format("  %s (%s)", list[i].path, list[i].class),
                    Color3.fromRGB(200, 200, 220))
            end
            if #list > 10 then
                addReport(string.format("  ... et %d autres (console)", #list - 10),
                    Color3.fromRGB(160, 160, 180))
                for i = 11, #list do
                    print("[" .. cat.nom .. "] " .. list[i].path)
                end
            end
            addReport("")
        end
    end

    local remoteCount = 0
    for _, d in ipairs(game:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            remoteCount += 1
        end
    end
    addReport(string.format("📡 Total remotes : %d", remoteCount),
        Color3.fromRGB(255, 220, 100), "header")
    addReport("")

    addReport("📊 Top classes", Color3.fromRGB(140, 200, 255), "header")
    local sorted = {}
    for k, v in pairs(stats) do table.insert(sorted, {k, v}) end
    table.sort(sorted, function(a, b) return a[2] > b[2] end)
    for i = 1, math.min(10, #sorted) do
        addReport(string.format("  %-25s : %d", sorted[i][1], sorted[i][2]),
            Color3.fromRGB(200, 220, 255))
    end
    addReport("")

    addReport("💡 Suggestions", Color3.fromRGB(200, 160, 255), "header")
    if #found["💰 Monnaie"] > 0 then
        addReport("  • Monnaie → regarde Remote Spy", Color3.fromRGB(255, 230, 150))
    end
    if #found["🛡 Anti-cheat"] > 0 then
        addReport("  • Anti-cheat détecté → prudence !", Color3.fromRGB(255, 150, 150))
    end
    if remoteCount > 0 then
        addReport("  • Remotes → onglet Spy", Color3.fromRGB(255, 210, 150))
    end

    addReport("")
    addReport("✅ Analyse terminée.", Color3.fromRGB(150, 255, 150), "header")
    notify("Analyse terminée !")
end

wBtn(AnalyzerPage, "🤖 Lancer l'analyse complète", runAnalysis)
