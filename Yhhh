    if attached[re] then return end
    attached[re] = true
    re.OnClientEvent:Connect(function(...)
        pcall(addLog, "OnClientEvent", re:GetFullName(), {...})
    end)
end
for _, d in ipairs(game:GetDescendants()) do
    if d:IsA("RemoteEvent") then attachRemote(d) end
end
game.DescendantAdded:Connect(function(d)
    if d:IsA("RemoteEvent") then
        task.wait(0.1)
        attachRemote(d)
    end
end)

if not hooked then
    spyStatus.Text = "⚠ Mode dégradé : OnClientEvent seulement"
    spyStatus.TextColor3 = Color3.fromRGB(255, 200, 100)
end
